@* VsActivityBarPanel.razor *@


@using PhilippWebsite.Client.Components.ActivityBar.SolutionExplorer
@using PhilippWebsite.Client.Components.Common

@using PhilippWebsite.Client.Models.BarSections

@using PhilippWebsite.Client.Resources

@using PhilippWebsite.Client.Services.WorkbenchState


@implements IDisposable


@inject IBarStateService<ActivityBarSection> ActivityBarStateService


@if (this.ActivityBarStateService.IsOpen)
{
    <div class="vs-activity-bar-panel-root @(this.ActivityBarStateService.IsPinned ? string.Empty : "absolute")">
        <div class="vs-activity-bar-panel-header">
            <span class="vs-activity-bar-panel-header-title">@this.Title</span>

            <div class="vs-activity-bar-panel-header-controls">
                <button class="vs-activity-bar-panel-header-controls-pin" @onclick="this.OnPinClick">
                    <VsIcon Icon="@(this.ActivityBarStateService.IsPinned ? VsIcons.Common.PushPin : VsIcons.Common.Pin)" IconSize="16" />
                </button>

                <button class="vs-activity-bar-panel-header-controls-close" @onclick="this.OnCloseClick">
                    <VsIcon Icon="@VsIcons.Common.Close" IconSize="16" />
                </button>
            </div>
        </div>

        <div class="vs-activitybar-panel-content">
            @switch (this.ActivityBarStateService.ActiveSection)
            {
                case ActivityBarSection.SolutionExplorer: <VsSolutionExplorerRoot /> break;
            }
        </div>
    </div>
}


@code {
    private string Title
    {
        get
        {
            return this.ActivityBarStateService.ActiveSection switch
            {
                ActivityBarSection.SolutionExplorer => "Solution Explorer",

                _ => string.Empty
            };
        }
    }

    protected override void OnInitialized() 
    { 
        this.ActivityBarStateService.OnChanged += this.StateHasChanged;
    }


    private void OnPinClick() => this.ActivityBarStateService.TogglePin();

    private void OnCloseClick() => this.ActivityBarStateService.Close();


    public void Dispose()
    {
        this.ActivityBarStateService.OnChanged -= this.StateHasChanged;
    }
}
