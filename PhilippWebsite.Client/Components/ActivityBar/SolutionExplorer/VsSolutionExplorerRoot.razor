@* VsProjectTreeRoot.razor *@


@using PhilippWebsite.Client.Models
@using PhilippWebsite.Client.Services.SolutionExplorer
@using PhilippWebsite.Client.Services.TabsBarState

@using PhilippWebsite.Shared.SolutionState


@inject ISolutionExplorerService SolutionExplorerService;

@inject TabsBarStateService TabsBarStateService;


<div class="vs-solution-explorer-root">

    @if (this._explorerRoot is not null)
    {
        @foreach (SolutionTreeItem item in this._explorerRoot.Items)
        {
            <VsSolutionExplorerItem Item="item" OnItemClick="this.OnItemClick"></VsSolutionExplorerItem>
        }
    }
    else
    {
        <span>Надо потерпеть.</span>
    }

</div>


@code {
    private SolutionTreeRoot? _explorerRoot;

    protected override async Task OnInitializedAsync()
    {
        this._explorerRoot = await this.SolutionExplorerService.GetTreeAsync();
    }


    private void OnItemClick(SolutionTreeItem item)
    {
        if (item.Type == SolutionTreeItemType.File)
        {
            this.TabsBarStateService.OpenAsActive(new TabModel() { Name = item.Name, Path = item.Path });
        }
    }
}