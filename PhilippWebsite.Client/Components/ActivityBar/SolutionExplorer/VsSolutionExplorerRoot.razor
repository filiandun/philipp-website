@* VsSolutionExplorerTreeRoot.razor *@


@using PhilippWebsite.Client.Models

@using PhilippWebsite.Client.Services.SolutionExplorer
@using PhilippWebsite.Client.Services.TabsBarState

@using PhilippWebsite.Shared.SolutionState


@implements IDisposable


@inject ISolutionExplorerService SolutionExplorerService;

@inject TabsBarStateService TabsBarStateService;


<div class="vs-solution-explorer-root">

    @if (this.SolutionExplorerService.IsLoading)
    {
        <div class="vs-solution-explorer-skeleton"></div>
    }
    else if (this.SolutionExplorerService.HasError || this.SolutionExplorerService.Tree is null)
    {
        <span>Error to load tree.</span>
    }
    else
    {
        <VsSolutionExplorerItem Item="this.SolutionExplorerService.Tree" OnItemClick="this.OnItemClick"></VsSolutionExplorerItem>
    }
</div>


@code {
    protected override void OnInitialized()
    {
        this.SolutionExplorerService.OnTreeChanged += this.StateHasChanged;
    }


    private void OnItemClick(SolutionTreeItem item)
    {
        if (item.Type == SolutionTreeItemType.File)
        {
            this.TabsBarStateService.OpenAsActive(new TabModel() { Name = item.Name, Path = item.TreePath });
        }
    }


    public void Dispose()
    {
        this.SolutionExplorerService.OnTreeChanged -= this.StateHasChanged;
    }
}