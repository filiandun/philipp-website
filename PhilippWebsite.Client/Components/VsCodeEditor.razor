@* VsCodeEditor.razor *@


@using PhilippWebsite.Client.Clients.EditorContent

@using PhilippWebsite.Client.Services.TabsBarState


@inject TabsBarStateService TabsBarStateService

@inject IEditorContentClient EditorContentClient


<div class="vs-editor-root">
    <div class="vs-editor-lines">
        @for (int i = 0; i < this._codeLines.Length; i++)
        {
            <div class="vs-editor-line">
                <span class="vs-editor-line-gutter">@(i + 1)</span>
                <span class="vs-editor-line-content">@((MarkupString)this._codeLines[i])</span>
            </div>
        }
    </div>
</div>


@code {
    private string[] _codeLines = [];


    protected override void OnInitialized()
    {
        this.TabsBarStateService.OnActiveTabChange += this.OnActiveTabChange;
    }


    private async void OnActiveTabChange()
    {
        if (this.TabsBarStateService.ActiveTab is null) return;

        string filePath = this.TabsBarStateService.ActiveTab.Path;

        this._codeLines = await this.EditorContentClient.GetCodeAsync(filePath);

        this.StateHasChanged();
    }


    public void Dispose()
    {
        this.TabsBarStateService.OnOpenTabsChange -= this.OnActiveTabChange;
    }
} 