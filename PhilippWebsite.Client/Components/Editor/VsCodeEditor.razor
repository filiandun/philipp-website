@* VsCodeEditor.razor *@


@using System.Globalization

@using PhilippWebsite.Client.Services.EditorContent


@implements IDisposable


@inject IEditorContentService EditorContentService


<div class="vs-editor-root">
    @if (this.EditorContentService.IsLoading)
    {
        <div class="vs-editor-skeleton"></div>
    }
    else if (this.EditorContentService.HasError)
    {
        <span>Error to load file.</span>
    }
    else if (this.EditorContentService.NothingSelected)
    {
        <span>Nothing selected.</span>
    }
    else if (this.EditorContentService.CurrentContent.Length == 0)
    {
        <span>File is empty.</span>
    }
    else
    {
        <div class="vs-editor-lines">
            @for (int i = 0; i < this.EditorContentService.CurrentContent.Length; i++)
            {
                double maxTotalDelay = 1.5;

                double step = Math.Min(0.03, maxTotalDelay / this.EditorContentService.CurrentContent.Length);

                string delayValue = (i * step).ToString("0.###", CultureInfo.InvariantCulture);

                <div @key="i" class="vs-editor-line" style="--line-anim-duration: @(delayValue)s;">
                    <span class="vs-editor-line-gutter">@(i + 1)</span>
                    <span class="vs-editor-line-content">@((MarkupString)this.EditorContentService.CurrentContent[i])</span>
                </div>
            }
        </div>
    }
</div>


@code {
    protected override void OnInitialized()
    {
        this.EditorContentService.OnContentChanged += this.StateHasChanged;
    }

    public void Dispose()
    {
        this.EditorContentService.OnContentChanged -= this.StateHasChanged;
    }
}