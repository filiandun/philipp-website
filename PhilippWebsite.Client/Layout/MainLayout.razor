@using PhilippWebsite.Client.Resources

@using PhilippWebsite.Client.Services.TabsBarState;

@using PhilippWebsite.Client.State;


@inherits LayoutComponentBase

@inject TabsBarStateService TabsBarStateService;
@inject SolutionStateContainer SolutionStateContainer;


<MudThemeProvider Theme="@this._theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


@Body


@code {
    private MudTheme? _theme;


    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        await this.SolutionStateContainer.InitializeAsync();
        await this.TabsBarStateService.InitializeAsync();

        this._theme = VsThemeConfiguration.GetTheme();
    }
}
