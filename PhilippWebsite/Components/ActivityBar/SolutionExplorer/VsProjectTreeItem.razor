@* VsProjectTreeNode.razor *@


@using PhilippWebsite.Components.Common

@using PhilippWebsite.Models
@using PhilippWebsite.Models.ProjectTree

@using PhilippWebsite.Resources

@using PhilippWebsite.Services.TabsBarState


@inject TabsBarStateService TabsBarStateService;


<div class="vs-project-tree-node-root">
    <div class="vs-project-tree-node-head" style="padding-left: @(this.Depth * 15)px;">
        <div class="vs-project-tree-node-head-expand" @onclick="this.OnExpandClick">
            @if (this.Item.Children.Any())
            {
                <VsIcon Icon="@(this._isExpanded ? VsIcons.ExpandDown : VsIcons.ExpandRight)" IconSize="16"></VsIcon>
            }
        </div>

        <div class="vs-project-tree-node-head-icon">
            @if (this.Item.Type == ProjectTreeItemType.File)
            {
                <VsIcon Icon="@VsIcons.CSFileNode" IconSize="16"></VsIcon>
            } 
            else
            {
                <VsIcon Icon="@VsIcons.Folder" IconSize="16"></VsIcon>
            }
        </div>

        <div class="vs-project-tree-node-head-content" @onclick="this.OnContentClick">
            <span>@this.Item.Name</span>
        </div>
    </div>

    @if (this._isExpanded)
    {  
        <div class="vs-project-tree-node-child">
            @foreach (var childNode in this.Item.Children)
            {
                <VsProjectTreeItem Item="childNode" Depth="(this.Depth + 1)"></VsProjectTreeItem>
            }
        </div>
    }
</div>


@code {
    [Parameter] public required ProjectTreeItem Item { get; set; }
    [Parameter] public int Depth { get; set; } = 0;

    private bool _isExpanded = false;

    private void OnExpandClick() => this._isExpanded = !this._isExpanded;
    private void OnContentClick() => this.TabsBarStateService.Open(new TabModel() { Name = this.Item.Name, Path = this.Item.Path });
}