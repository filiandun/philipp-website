@* VsProjectTreeItem.razor *@


@using PhilippWebsite.Components.Common

@using PhilippWebsite.Models
@using PhilippWebsite.Models.SolutionExplorer

@using PhilippWebsite.Resources

@using PhilippWebsite.Services.TabsBarState


@inject TabsBarStateService TabsBarStateService;


<div class="vs-solution-explorer-item-root">

    <div class="vs-solution-explorer-item-head" style="padding-left: @(this.Depth * 15);">

        <div class="vs-solution-explorer-item-head-expand" @onclick="this.OnExpandClick">
            @if (this.Item.Items.Count != 0)
            {
                <VsIcon Icon="@(this._isExpanded ? VsIcons.ExpandDown : VsIcons.ExpandRight)" IconSize="16"></VsIcon>
            }
        </div>

        <div class="vs-solution-explorer-item-head-icon">
            @switch (this.Item.Type)
            {
                case SolutionExplorerItemType.Solution: <VsIcon Icon="@VsIcons.VisualStudio" IconSize="16"></VsIcon> break;

                case SolutionExplorerItemType.Project: <VsIcon Icon="@VsIcons.AspProject" IconSize="16"></VsIcon> break;

                case SolutionExplorerItemType.Folder: <VsIcon Icon="@VsIcons.Folder" IconSize="16"></VsIcon> break;
                case SolutionExplorerItemType.File: <VsIcon Icon="@VsIcons.CSFileNode" IconSize="16"></VsIcon> break;
            } 
        </div>

        <div class="vs-solution-explorer-item-head-content" @onclick="this.OnContentClick">
            <span>@this.Item.Name</span>
        </div>

    </div>

    @if (this._isExpanded)
    {  
        <div class="vs-solution-explorer-item-child">
            @foreach (SolutionExplorerItem item in this.Item.Items)
            {
                <VsSolutionExplorerItem Item="item" Depth="(this.Depth + 1)"></VsSolutionExplorerItem>
            }
        </div>
    }
</div>


@code {
    [Parameter] public required SolutionExplorerItem Item { get; set; }
    [Parameter] public int Depth { get; set; } = 0;

    private bool _isExpanded = false;

    private void OnExpandClick() => this._isExpanded = !this._isExpanded;
    private void OnContentClick() => this.TabsBarStateService.Open(new TabModel() { Name = this.Item.Name, Path = this.Item.Path, Repo = this.Item.Repo, Source = this.Item.Source });
}