@* VsSolutionExplorerItem.razor *@


@using PhilippWebsite.Components.Common

@using PhilippWebsite.Models.SolutionExplorer

@using PhilippWebsite.Resources

@using PhilippWebsite.Services


<div class="vs-solution-explorer-item-root" @onclick="this.OnContentClick">

    <div class="vs-solution-explorer-item-head" style="padding-left: @(this.Depth * 15)px;">

        <div class="vs-solution-explorer-item-head-expand" @onclick="this.OnExpandClick" @onclick:stopPropagation="true">
            @if (this.Item.Items.Count != 0)
            {
                <VsIcon Icon="@(this.Item.IsExpanded ? VsIcons.SolutionExplorer.Expands.Down : VsIcons.SolutionExplorer.Expands.Right)" IconSize="16"></VsIcon>
            }
        </div>

        <div class="vs-solution-explorer-item-head-icon">
            @switch (this.Item.Type)
            {
                case SolutionExplorerItemType.Solution: <VsIcon Icon="@IconResolver.GetSolutionIcon(this.Item.Name)" IconSize="16"></VsIcon> break;

                case SolutionExplorerItemType.Project: <VsIcon Icon="@IconResolver.GetProjectIcon(this.Item.Name)" IconSize="16"></VsIcon> break;

                case SolutionExplorerItemType.Folder: <VsIcon Icon="@IconResolver.GetFolderIcon(this.Item.Name)" IconSize="16"></VsIcon> break;
                case SolutionExplorerItemType.File: <VsIcon Icon="@IconResolver.GetFileIcon(this.Item.Name)" IconSize="16"></VsIcon> break;
            } 
        </div>

        <div class="vs-solution-explorer-item-head-content">
            <span>@this.Item.Name</span>
        </div>

    </div>

    @if (this.Item.IsExpanded)
    {  
        <div class="vs-solution-explorer-item-child">
            @foreach (SolutionExplorerItem item in this.Item.Items)
            {
                <VsSolutionExplorerItem Item="item" Depth="(this.Depth + 1)" OnItemClick="this.OnItemClick"></VsSolutionExplorerItem>
            }
        </div>
    }
</div>


@code {
    [Parameter] public EventCallback<SolutionExplorerItem> OnItemClick { get; set; }

    [Parameter] public required SolutionExplorerItem Item { get; set; }
    [Parameter] public int Depth { get; set; } = 0;

    private void OnExpandClick() => this.Item.IsExpanded = !this.Item.IsExpanded;
    private void OnContentClick() => this.OnItemClick.InvokeAsync(this.Item);
}