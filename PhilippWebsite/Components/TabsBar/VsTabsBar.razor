@* VsTabsBar.razor *@


@using PhilippWebsite.Components.Common
@using PhilippWebsite.Resources

@using PhilippWebsite.Services.TabsBarState


@inject TabsBarStateService TabsBarStateService


<div class="vs-tabsbar-root">
    @foreach (var tab in this.TabsBarStateService.OpenTabs)
    {
        <div class="vs-tabsbar-tab @(TabsBarStateService.ActiveTab == tab ? "active" : "")" @onclick="() => this.TabsBarStateService.SetActive(tab)">
            <span class="vs-tabsbar-tab-content">@tab.Name</span>

            <span class="vs-tabsbar-tab-pin" @onclick:stopPropagation="true">
                <VsIcon Class="vs-tabsbar-tab-pin-icon" Icon="@VsIcons.TabsBar.PushPin" IconSize="16" />
            </span>

            <span class="vs-tabsbar-tab-close" @onclick="() => this.TabsBarStateService.Close(tab)" @onclick:stopPropagation="true">
                <VsIcon Class="vs-tabsbar-tab-close-icon" Icon="@VsIcons.TabsBar.Close" IconSize="16" />
            </span>
        </div>        
    }
</div>


@code {
    protected override void OnInitialized()
    {
        this.TabsBarStateService.OnOpenTabsChange += this.StateHasChanged;
    }

    public void Dispose()
    {
        this.TabsBarStateService.OnOpenTabsChange -= this.StateHasChanged;
    }
}
