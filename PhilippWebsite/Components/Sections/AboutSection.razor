@using PhilippWebsite.Models

<MudPaper MaxWidth="MaxWidth.Large" Class="section-content about-section rounded-xl pa-20" Elevation="10">
    <MudText Typo="Typo.h1" Color="Color.Primary" GutterBottom="false">@Content.Title</MudText>
    
    <MudText Typo="Typo.h3" GutterBottom="true">@Content.Paragraphs[0]</MudText>

    @foreach (var paragraph in Content.Paragraphs.Skip(1)) // TODO n(много)
    {
        <p><MudText Typo="Typo.body1" GutterBottom="true">@paragraph</MudText></p>
    }

    <div class="py-4">
        <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">C#</MudChip>
        <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">.NET</MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Large">ASP.NET Core</MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Large">Entity Framework Core</MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Large">PostgreSQL</MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Large">Blazor WASM</MudChip>
    </div>
</MudPaper>

@code {
    [Parameter]
    public required AboutContent Content { get; set; }
}