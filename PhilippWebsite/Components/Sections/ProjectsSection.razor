@using PhilippWebsite.Models

<MudContainer MaxWidth="MaxWidth.Large" Class="section-content projects-section pa-0">
    <MudPaper Class="rounded-xl pa-20" Elevation="10">
        <MudText Typo="Typo.h1" Color="Color.Primary" GutterBottom="true">@Content.Title</MudText>

        <MudTimeline>
            @foreach (var item in Content.Items)
            {
                <MudTimelineItem Icon="@Icons.Material.Filled.Rocket" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <ItemOpposite>
                        @* ВМЕСТО ПРОСТО MudImage СДЕЛАТЬ MudCarousel, А В resume.json СПИСОК КАРТИНОК, А ТУТ ЦИКЛОМ ПРОХОДИТСЯ *@
                        <MudImage Src="@item.Image" Alt="@item.Image" Width="500" Elevation="20" Class="rounded-xl" Style="aspect-ratio: 16/10; object-fit: cover"></MudImage>
                    </ItemOpposite>
                    <ItemContent>
                        <div class="my-20">
                            <MudText Typo="Typo.h2" Color="Color.Secondary" GutterBottom="true">@item.Name</MudText>

                            <MudText Typo="Typo.body1" Color="Color.Surface" GutterBottom="true">@item.Description</MudText>

                            @* <MudDivider /> *@

                            <div>
                                @foreach (var stack in item.Stack)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">@stack</MudChip>
                                }
  
                                @foreach (var highlight in item.Highlights)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium">@highlight</MudChip>
                                }
                            </div>

                            @* <MudDivider /> *@

                            <div class="my-4">
                                <MudButton Href="@item.DemoUrl" StartIcon="@Icons.Material.Filled.Link" Variant="Variant.Outlined">Demonstration</MudButton>

                                <MudButton Href="@item.GithubUrl" StartIcon="@Icons.Custom.Brands.GitHub" Variant="Variant.Outlined">GitHub</MudButton>
                            </div>
                        </div>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public required ProjectsContent Content { get; set; }
}