@using PhilippWebsite.Models


<MudPaper MaxWidth="MaxWidth.Large" Class="section-content about-section rounded-xl pa-20" Elevation="10">
    <MudText Typo="Typo.h1" Color="Color.Primary" GutterBottom="true">@Content.Title</MudText>

    <MudTimeline>
        @foreach (var item in Content.Items)
        {
        <MudTimelineItem Icon="@Icons.Material.Filled.Rocket" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
            <div class="my-20">
                <p><MudText Typo="Typo.h3" Color="Color.Secondary" GutterBottom="true">@item.Name</MudText></p>
                <p><MudText Typo="Typo.body1" Color="Color.Surface" GutterBottom="true">@item.Description</MudText></p>

                <div>
                    @foreach (var stack in item.Stack)
                    {
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">@stack</MudChip>
                    }
  
                    @foreach (var highlight in item.Highlights)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium">@highlight</MudChip>
                    }
                </div>

                <div class="ma-4">
                    <p>
                        <MudLink Href="@item.DemoUrl" StartIcon="@Icons.Material.Filled.Link">Demonstration</MudLink>
                    </p>
                    <p>
                        <MudLink Href="@item.GithubUrl" StartIcon="@Icons.Custom.Brands.GitHub">GitHub</MudLink>
                    </p>
                </div>
            </div>
        </MudTimelineItem>
        }
    </MudTimeline>
</MudPaper>

@code {
    [Parameter]
    public required ProjectsContent Content { get; set; }
}