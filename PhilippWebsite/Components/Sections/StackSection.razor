@using PhilippWebsite.Models


<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <MudText Typo="Typo.h1" Color="Color.Primary" Class="pa-4">@Content.Title</MudText>
    
    <MudGrid Spacing="6">
        @foreach (var group in this.Content.Groups)
        {
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-10 d-flex flex-column justify-space-between rounded-xl" Elevation="10" Style="height: 100%; min-height: 320px;">
                    <div>
                        <div class="d-flex align-center gap-3 mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h3">@group.Title</MudText>
                        </div>

                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                            ---------------------------------------------
                            @* Базовый фундамент, с которым работаю каждый день. @* @group.Description *@
                        </MudText>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @for (int i = 0; i < group.Items.Length - 1; i++)
                        {
                            var item = group.Items[i];
                            bool isFirstElements = i < 2;

                            <MudChip @key='$"chip_{i}_{item}"'
                                     T="string"
                                     Variant="@(isFirstElements ? Variant.Filled : Variant.Outlined)"
                                     Color="@(isFirstElements ? Color.Primary : Color.Default)"
                                     Size="Size.Large">
                                @item
                            </MudChip>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }

