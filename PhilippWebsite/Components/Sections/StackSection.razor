@using PhilippWebsite.Models


<MudContainer MaxWidth="MaxWidth.Large" Class="section-content stack-section pa-0">
    <MudText Typo="Typo.h1" Color="Color.Primary" Class="pa-4">@Content.Title</MudText>
    
    <MudGrid Spacing="6">
        @foreach (StackGroup group in this.Content.Groups)
        {
            bool isFirstGroup = ReferenceEquals(group, this.Content.Groups[0]);

            <MudItem xs="12" md="@group.ColumnSpan">
                <MudPaper Class="pa-10 d-flex flex-column justify-space-between rounded-xl" Elevation="20">
                    <div>
                        <div class="d-flex align-center gap-3 mb-4">
                            <MudIcon Icon="@IconMapper.GetIcon(group.Icon)" Color="group.ThemeColor" Size="Size.Large" />
                            <MudText Typo="Typo.h5">@group.Title</MudText>
                        </div>

                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                        </MudText>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (string item in group.Items)
                        {
                            bool isFirstElements = isFirstGroup && group.Items.IndexOf(item) < 2;
                                
                            <MudChip T="string"
                                     Variant="@(isFirstElements ? Variant.Filled : group.ChipVariant)"
                                     Color="@(isFirstElements ? Color.Primary : group.ThemeColor)"
                                     Size="Size.Large">
                                     @item
                            </MudChip>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudContainer>


@code {
    [Parameter]
    public required StackContent Content { get; set; }
}