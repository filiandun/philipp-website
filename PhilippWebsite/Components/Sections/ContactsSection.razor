@using PhilippWebsite.Models

<MudPaper Class="section-content about-section rounded-xl pa-20" Width="100%" Elevation="10">
    <MudText Typo="Typo.h1" Color="Color.Primary" GutterBottom="true">@Content.Title</MudText>

    <MudText Typo="Typo.h4" GutterBottom="true">@Content.Description</MudText>
</MudPaper>

@code {
    [Parameter]
    public required ContactsContent Content { get; set; }
}
