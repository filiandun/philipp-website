@using PhilippWebsite.Models


<MudContainer MaxWidth="MaxWidth.Large" Class="section-content contacts-section pa-0">
    <MudPaper Class="rounded-xl pa-20 relative overflow-hidden" Elevation="20" Style="position: relative;">
        <MudText Typo="Typo.h1" Color="Color.Primary">@this.Content.Title</MudText>

        <MudText Typo="Typo.body1" Class="mb-10">@this.Content.Description</MudText>

        <MudGrid Spacing="4">
            @foreach (ContactContent contact in this.Content.Items)
            {
                bool isFirstContact = ReferenceEquals(contact, this.Content.Items[0]);

                <MudItem xs="12" md="@contact.ColumnSpan">
                    <a href="@contact.Url" target="_blank" style="text-decoration: none;">
                        <MudPaper Class="pa-6 rounded-xl d-flex align-center justify-space-between transition-all" Elevation="0" Style="@(isFirstContact ? 
                                                                                                                                "background: var(--mud-palette-primary); color: white; cursor: pointer;"
                                                                                                                                : "background: rgba(255, 255, 255, 0.03); color: var(--mud-palette-text-primary); cursor: pointer;")">
                            <div class="d-flex align-center gap-4">
                                <MudIcon Icon="@IconMapper.GetIcon(contact.IconName)" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">@contact.Label</MudText>
                                    <MudText Typo="Typo.body2" Color="@(isFirstContact ? Color.Default : Color.Secondary)" Style="opacity: 0.8;">@contact.Value</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Medium" />
                        </MudPaper>
                    </a>
                </MudItem>
            }
        </MudGrid>

        <div style="position: absolute; right: 20px; bottom: -60px; font-size: 16rem; font-weight: 900; opacity: 0.03; line-height: 1; user-select: none; pointer-events: none;">
            <MudIcon Icon="@Icons.Material.Outlined.AlternateEmail" style="font-size: 32rem; font-weight: 900;" />
        </div>
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public required ContactsContent Content { get; set; }
}
