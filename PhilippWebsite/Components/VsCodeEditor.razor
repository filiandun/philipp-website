@* VsCodeEditor.razor *@


@using ColorCode
@using ColorCode.Styling;

@using PhilippWebsite.Services.TabsBarState
@using PhilippWebsite.Services.FileContent


@inject TabsBarStateService TabsBarStateService
@inject IFileContentService FileContentService


<div class="vs-editor-root">
    <div class="vs-editor-highlighter">
        @for (int i = 1; i <= this._lineCount; i++)
        {
            <div class="vs-editor-highlighter-line">@i</div>
        }
    </div>

    <div class="vs-editor-gutter">
        @for (int i = 1; i <= this._lineCount; i++)
        {
            <div class="vs-editor-gutter-line">@i</div>
        }
    </div>

    <div class="vs-editor-content">
        @((MarkupString)this._htmlString)
    </div>
</div>


@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public ILanguage Language { get; set; } = Languages.CSharp;

    private static HtmlFormatter _formatter = new HtmlFormatter(StyleDictionary.DefaultDark);

    private int _lineCount;

    private string _htmlString = string.Empty;


    protected override void OnInitialized()
    {
        this.TabsBarStateService.OnChange += this.OnTabChange;
    }


    // TODO надо сделать отдельное событие ActiveTabChange
    private async void OnTabChange()
    {
        if (this.TabsBarStateService.ActiveTab is null) return;

        string content = await this.FileContentService.GetContentAsync(this.TabsBarStateService.ActiveTab.Repo, this.TabsBarStateService.ActiveTab.Path, this.TabsBarStateService.ActiveTab.Source);


        this._lineCount = content.Split('\n').Length;

        this._htmlString = _formatter.GetHtmlString(content, this.Language);

        this.StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(this.Code)) return;

        this._lineCount = this.Code.Split('\n').Length;

        this._htmlString = _formatter.GetHtmlString(this.Code, this.Language);
    }


    public void Dispose()
    {
        this.TabsBarStateService.OnChange -= this.OnTabChange;
    }
} 