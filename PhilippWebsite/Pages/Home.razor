@page "/"

@using PhilippWebsite.Components
@using PhilippWebsite.Components.ActivityBar
@using PhilippWebsite.Components.Common
@using PhilippWebsite.Components.Common.Menu
@using PhilippWebsite.Components.TabsBar
@using PhilippWebsite.Components.ToolBar

@using PhilippWebsite.Models
@using PhilippWebsite.Models.SolutionExplorer

@using PhilippWebsite.Resources

@using PhilippWebsite.Services.SolutionExplorer
@using PhilippWebsite.Services.SolutionExplorer.Local
@using PhilippWebsite.Services.TabsBarState


@inject SolutionExplorerService SolutionExplorerService
@inject TabsBarStateService TabsBarStateService


<div class="vs-window">
    <header class="vs-header">
        <div class="vs-titlebar">

            <div class="vs-titlebar-left">
                <VsIcon Icon="@VsIcons.Common.VisualStudio" IconSize="32" IconColor="var(--mud-palette-primary)"></VsIcon>

                <div class="vs-menu-list">
                    <VsMenu Label="File">
                        <VsMenuItem ItemIcon="@VsIcons.Common.VisualStudio" ItemText="Download CV (.pdf)"></VsMenuItem>
                        <VsMenuItem ItemIcon="@VsIcons.Common.VisualStudio" ItemText="Print"></VsMenuItem>
                    </VsMenu>

                    <VsMenu Label="Git">
                        <VsMenuItem ItemIcon="@VsIcons.Common.VisualStudio" ItemText="Open GitHub"></VsMenuItem>
                    </VsMenu>

                    <VsMenu Label="Help">
                        <VsMenuItem ItemIcon="@VsIcons.Common.VisualStudio" ItemText="About This Portfolio"></VsMenuItem>
                    </VsMenu>

                    <VsMenu Label="Search">
                        <VsMenuItem ItemIcon="@VsIcons.Common.VisualStudio" ItemText="PhilippWebsite (Ctrl+Q)"></VsMenuItem>
                    </VsMenu>
                </div>

                <span class="vs-solution-name">PhilippPortfolio.sln - Microsoft Visual Studio</span>
            </div>

            <div class="vs-titlebar-rigth">
                <VsToolBarButton Icon="@VsIcons.Common.Close" IconSize="24" Class="vs-close-btn"></VsToolBarButton>
            </div>
        </div>

        <div class="vs-toolbars">
            <VsToolBar Class="vs-toolbar"> @* TODO тут снаружи, и внутри, повторяются именна классов, тут класс нужен, так как margin добавляется, чтобы не липли друг к другу они*@
                <VsToolBarButton Icon="@VsIcons.ToolBar.Backwards" IconColor="#3EA0E5"></VsToolBarButton>
                <VsToolBarButton Icon="@VsIcons.ToolBar.Forwards" IconColor="#3EA0E5"></VsToolBarButton>

                <MudDivider Vertical="true" FlexItem="true"></MudDivider>

                <VsToolBarButton Icon="@VsIcons.ToolBar.Home"></VsToolBarButton>

                <MudDivider Vertical="true" FlexItem="true"></MudDivider>

                <VsToolBarButton Icon="@VsIcons.ToolBar.Save" IconColor="#3EA0E5"></VsToolBarButton>
            </VsToolBar>

            <VsToolBar Class="vs-toolbar">
                <VsToolBarButton Icon="@VsIcons.ToolBar.Run" Text="debug" IconColor="#85E876"></VsToolBarButton>
                <VsToolBarButton Icon="@VsIcons.ToolBar.RunOutline" IconColor="#85E876"></VsToolBarButton>

                <MudDivider Vertical="true" FlexItem="true"></MudDivider>

                <VsToolBarButton Icon="@VsIcons.ToolBar.Refresh"></VsToolBarButton>
            </VsToolBar>
        </div>
    </header>


    <div class="vs-workbench">
        <main class="vs-editor-viewport">
            <VsTabsBar></VsTabsBar>

            @* TODO сломанные highlightedline*@
            <div class="vs-editor-content">
                <VsCodeEditor></VsCodeEditor>
            </div>
        </main>

        <div class="vs-activitybar">
            <VsActivityBar></VsActivityBar>
        </div>
    </div>

    <footer class="vs-footer">
        <div class="vs-footer-status-left">
            <span class="status-item ready">Ready</span>
            <span class="status-item">main*</span>
        </div>

        <div class="vs-footer-status-right">
            <span class="status-item">UTF-8</span>
            <span class="status-item">C# 15</span>
            <span class="status-item">.NET 10.0</span>
        </div>
    </footer>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        SolutionExplorerRoot? solutionExplorerRoot = await this.SolutionExplorerService.GetTreeAsync();

        if (solutionExplorerRoot is null) return;
    
        var firstSolution = solutionExplorerRoot.FirstOrDefault(x => x.Name == LocalTreeConfig.SolutionName);

        if (firstSolution is not null) firstSolution.IsExpanded = true;

        foreach (string fileName in LocalTreeConfig.FileList)
        {
            this.TabsBarStateService.Open(new TabModel { 
                Name = fileName, 
                Path = fileName, 
                Repo = LocalTreeConfig.SolutionName,
                Source = FileSource.Local
            });
        }
    }
}
